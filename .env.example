DATABASE_URL=postgres://voxrag:voxrag_dev@localhost:5433/vox_rag
PORT=3000
LOG_LEVEL=info

EMBEDDING_PROVIDER=octen
EMBEDDING_MODEL=octen-embedding-8b
EMBEDDING_DIMENSION=4096
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_MS=60000

OCTEN_API_KEY=your-octen-api-key-here
OCTEN_API_BASE_URL=https://api.octen.ai

SIMILARITY_NEAR_DUPLICATE_THRESHOLD=0.92
SIMILARITY_SAME_STORY_THRESHOLD=0.86
SIMILARITY_CONTEXT_THRESHOLD=0.78
SIMILARITY_WEAK_THRESHOLD=0.70

TOPIC_STRONG_MATCH_THRESHOLD=0.84
TOPIC_AMBIGUOUS_MATCH_THRESHOLD=0.76
TOPIC_WEAK_MATCH_THRESHOLD=0.70
TOPIC_MARKDOWN_MAX_WORDS=1500
TOPIC_ACTIVE_DAYS=3
TOPIC_ARCHIVE_DAYS=14

# LLM Arbitration (DeepSeek)
# Prix: $0.14/1M input, $0.28/1M output. Coût par décision: ~$0.00007
# Thinking désactivé par défaut (économie de ~65% de tokens)
# Cache: supporté mais non exploité (le prompt user change à chaque appel)
# Doc: docs/deepseek-api-reference.md
USE_LLM_FOR_TOPICS=true
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=30000
